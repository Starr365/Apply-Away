generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION MODELS (Auth.js v5 / NextAuth Multi-Tenant Foundation)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("Africa/Lagos")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  opportunities      Opportunity[]
  essayQuestions     EssayQuestion[]
  activityLogs       ActivityLog[]
  reminderLogs       ReminderLog[]
  monthlyReflections MonthlyReflection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// DOMAIN ENUMS
// -----------------------------------------------------------------------------

enum OpportunityCategory {
  FELLOWSHIP
  SCHOLARSHIP
  INTERNSHIP
  JOB
  GRANT
  COMPETITION
  RESEARCH
  CONFERENCE
  BOOTCAMP
  TRAINING
  OTHER
}

enum OpportunityStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum OpportunityPriority {
  HIGH
  MEDIUM
  LOW
}

// -----------------------------------------------------------------------------
// CORE OPPORTUNITY VAULT MODELS
// Every model includes `userId` for strict multi-tenant SaaS isolation.
// -----------------------------------------------------------------------------

model Opportunity {
  id               String              @id @default(cuid())
  userId           String
  title            String
  organization     String
  category         OpportunityCategory @default(OTHER)
  shortDescription String              @db.Text
  fullDescription  String?             @db.Text
  eligibility      String[]            @default([])
  requirements     String[]            @default([])
  benefits         String[]            @default([])
  applicationUrl   String              @default("")
  officialUrl      String              @default("")
  startDate        DateTime?
  deadline         DateTime?
  interviewDate    DateTime?
  originalTimezone String              @default("Africa/Lagos")
  deadlineUtc      DateTime?
  deadlineLocal    String?
  status           OpportunityStatus   @default(NOT_STARTED)
  priority         OpportunityPriority @default(MEDIUM)
  personalNotes    String              @default("") @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  essayQuestions EssayQuestion[]
  activityLogs   ActivityLog[]
  reminderLogs   ReminderLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, deadline])
  @@map("opportunities")
}

model EssayQuestion {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  question      String   @db.Text
  wordLimit     Int?
  draftResponse String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([userId])
  @@map("essay_questions")
}

model ActivityLog {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  action        String
  description   String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([userId])
  @@map("activity_logs")
}

model ReminderLog {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  reminderType  String   // e.g., "14_DAYS", "7_DAYS", "3_DAYS", "24_HOURS", "12_HOURS"
  sentAt        DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([userId])
  @@map("reminder_logs")
}

model MonthlyReflection {
  id        String   @id @default(cuid())
  userId    String
  monthYear String   // Format: "YYYY-MM" (e.g., "2026-08")
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear])
  @@index([userId])
  @@map("monthly_reflections")
}
